# Copier en .env.local. Site statique (GitHub Pages) : seules l'URL et la clé anon,
# publiques par nature, sont utilisées par le navigateur.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Ancien nom accepté : NEXT_PUBLIC_SUPABASE_ANON_KEY
# Ne jamais mettre SUPABASE_SERVICE_ROLE_KEY ici : réservée à la CLI et aux sauvegardes.
